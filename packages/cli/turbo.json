{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "tsup.config.ts",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/packages/claude-design/src/**",
        "$TURBO_ROOT$/packages/catalog/scripts/**"
      ],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": []
    }
  }
}
