{
  "name": "@nxds/react",
  "version": "0.11.0",
  "private": true,
  "description": "React components built with Radix UI and Tailwind CSS",
  "//": [
    "@nxds/core is a runtime dependency of @nxds/react/appearance; Vite marks it external so the runtime theme engine is consumed from @nxds/core, not bundled into @nxds/react.",
    "Tracked for restructure: https://github.com/nexuslabs-ai/nxds/issues/66 (move to @nxds/tailwind dependsOn @nxds/core#build:tailwind in turbo)."
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/lib/utils.d.ts",
        "default": "./dist/lib/utils.mjs"
      },
      "require": {
        "types": "./dist/lib/utils.d.cts",
        "default": "./dist/lib/utils.cjs"
      }
    },
    "./code-block-theme": {
      "import": {
        "types": "./dist/components/code-block/code-block-theme.d.ts",
        "default": "./dist/components/code-block/code-block-theme.mjs"
      },
      "require": {
        "types": "./dist/components/code-block/code-block-theme.d.cts",
        "default": "./dist/components/code-block/code-block-theme.cjs"
      }
    },
    "./appearance": {
      "import": {
        "types": "./dist/components/appearance/provider/index.d.ts",
        "default": "./dist/components/appearance/provider/index.mjs"
      },
      "require": {
        "types": "./dist/components/appearance/provider/index.d.cts",
        "default": "./dist/components/appearance/provider/index.cjs"
      }
    },
    "./appearance/server": {
      "import": {
        "types": "./dist/components/appearance/provider/server.d.ts",
        "default": "./dist/components/appearance/provider/server.mjs"
      },
      "require": {
        "types": "./dist/components/appearance/provider/server.d.cts",
        "default": "./dist/components/appearance/provider/server.cjs"
      }
    },
    "./styles.css": "./dist/react.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "node scripts/typecheck-dist.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@shikijs/langs": "4.4.3",
    "@storybook/addon-a11y": "^10.1.10",
    "@storybook/addon-docs": "^10.1.10",
    "@storybook/react-vite": "^10.1.10",
    "@tailwindcss/vite": "4.3.0",
    "@tanstack/react-form": "^1.33.5",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "embla-carousel-react": "^8.6.0",
    "react-day-picker": "^9",
    "react-hook-form": "^7.77.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "shiki": "4.4.3",
    "sonner": "^2.0.7",
    "storybook": "^10.1.10",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^5.1.2"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@nxds/core": "workspace:*",
    "@nxds/tailwind": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-compose-refs": "^1.1.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-toolbar": "1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@remixicon/react": "^4.9.0",
    "@tabler/icons-react": "^3.36.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.61.0",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "embla-carousel-react": "^8.6.0",
    "react": "^19.0.0",
    "react-day-picker": "^9",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "^3.8.1",
    "sonner": "^2.0.7",
    "vaul": "^1.1.2"
  },
  "peerDependenciesMeta": {
    "embla-carousel-react": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "vaul": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT"
}
