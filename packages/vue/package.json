{
  "name": "@nxds/vue",
  "version": "0.4.0",
  "private": true,
  "description": "Vue components built with Reka UI and Tailwind CSS",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/vue.css"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@nxds/core": "workspace:*",
    "@nxds/tailwind": "workspace:*",
    "@tabler/icons-vue": "^3.36.1",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.4.0"
  },
  "peerDependencies": {
    "embla-carousel-vue": "^8.6.0",
    "vaul-vue": "^0.4.1",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "embla-carousel-vue": {
      "optional": true
    },
    "vaul-vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.9",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/vue3-vite": "10.4.2",
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "embla-carousel-vue": "^8.6.0",
    "storybook": "^10.4.2",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vaul-vue": "^0.4.1",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "license": "MIT"
}
